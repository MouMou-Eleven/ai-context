{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jianwei.example/schemas/motion-blueprint.schema.json",
  "title": "Jianwei Remotion Motion Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "approval", "referenceFidelity", "creativeDirection", "motionSystem", "timeline", "parameterization", "remotionPlan", "renderPipeline", "quality"],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputMode", "goal", "deliverable", "width", "height", "fps", "durationSeconds", "confirmedFacts", "assumptions"],
      "properties": {
        "inputMode": {"enum": ["text", "image", "hybrid"]},
        "goal": {"type": "string", "minLength": 1},
        "audience": {"type": ["string", "null"]},
        "platform": {"type": ["string", "null"]},
        "deliverable": {"enum": ["blueprint", "code", "preview", "render"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "integer", "minimum": 1},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "confirmedFacts": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "approvedScope", "evidence"],
      "properties": {
        "mode": {"enum": ["required", "explicitly-waived"]},
        "status": {"enum": ["pending", "approved"]},
        "approvedScope": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "visualAnalysis": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["observed", "hierarchy", "coreVisual", "preserve", "mayChange", "layerCandidates", "risks"],
      "properties": {
        "observed": {"type": "array", "items": {"type": "string"}},
        "hierarchy": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "coreVisual": {"type": "string", "minLength": 1},
        "palette": {"type": "array", "items": {"type": "string"}},
        "typography": {"type": "array", "items": {"type": "string"}},
        "preserve": {"type": "array", "items": {"type": "string"}},
        "mayChange": {"type": "array", "items": {"type": "string"}},
        "layerCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "depth", "source", "editable"],
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string"},
              "depth": {"type": "number"},
              "source": {"type": "string"},
              "editable": {"type": "boolean"}
            }
          }
        },
        "risks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "referenceFidelity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["mode", "sourceWidth", "sourceHeight", "exactCopy", "protectedElements", "allowedDifferences", "criticalRegions", "finalFrameRule", "comparisonMethod"],
      "properties": {
        "mode": {"enum": ["reference-locked", "editable-overlay", "rebuild"]},
        "sourceWidth": {"type": "integer", "minimum": 1},
        "sourceHeight": {"type": "integer", "minimum": 1},
        "exactCopy": {"type": "array", "items": {"type": "string"}},
        "protectedElements": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "allowedDifferences": {"type": "array", "items": {"type": "string"}},
        "criticalRegions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "normalizedBounds", "tolerancePercent"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "normalizedBounds": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, {"type": "number", "exclusiveMinimum": 0, "maximum": 1}], "items": false, "minItems": 4, "maxItems": 4},
              "tolerancePercent": {"type": "number", "minimum": 0, "maximum": 10}
            }
          }
        },
        "finalFrameRule": {"type": "string", "minLength": 1},
        "comparisonMethod": {"type": "string", "minLength": 1}
      }
    },
    "creativeDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "targetFrame", "stateContrast", "memoryHook", "memoryHookTime", "payoff", "timingOverlap", "styleWords", "intensity", "spatialModel"],
      "properties": {
        "concept": {"type": "string", "minLength": 1},
        "targetFrame": {"type": "string", "minLength": 1},
        "stateContrast": {"type": "string", "minLength": 1},
        "memoryHook": {"type": "string", "minLength": 1},
        "memoryHookTime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startSeconds", "endSeconds"],
          "properties": {
            "startSeconds": {"type": "number", "minimum": 0},
            "endSeconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "payoff": {"type": "string", "minLength": 1},
        "timingOverlap": {"type": "string", "minLength": 1},
        "styleWords": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 6},
        "intensity": {"type": "integer", "minimum": 1, "maximum": 3},
        "spatialModel": {"enum": ["2d", "2.5d", "3d", "hybrid"]},
        "spatialModelReason": {"type": "string"}
      }
    },
    "motionSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heroAction", "cameraPath", "elementActions", "secondaryActions", "microMotion", "continuityAnchor", "focusStrategy", "transitionLanguage", "audioStrategy", "negativeConstraints"],
      "properties": {
        "heroAction": {"type": "string", "minLength": 1},
        "cameraPath": {"type": "string", "minLength": 1},
        "elementActions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["element", "trigger", "startState", "motion", "durationSeconds", "easing", "causes", "endState", "implementation"],
            "properties": {
              "element": {"type": "string", "minLength": 1},
              "trigger": {"type": "string", "minLength": 1},
              "startState": {"type": "string", "minLength": 1},
              "motion": {"type": "string", "minLength": 1},
              "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
              "easing": {"type": "string", "minLength": 1},
              "causes": {"type": "string", "minLength": 1},
              "endState": {"type": "string", "minLength": 1},
              "implementation": {"type": "string", "minLength": 1}
            }
          }
        },
        "secondaryActions": {"type": "array", "items": {"type": "string"}},
        "microMotion": {"type": "array", "items": {"type": "string"}},
        "continuityAnchor": {"type": "string", "minLength": 1},
        "focusStrategy": {"type": "string", "minLength": 1},
        "transitionLanguage": {"type": "array", "items": {"type": "string"}},
        "audioStrategy": {"type": "array", "items": {"type": "string"}},
        "negativeConstraints": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startSeconds", "endSeconds", "beat", "pictureAction", "camera", "focusAndLayers", "causalOverlap", "audioCue", "implementation"],
        "properties": {
          "startSeconds": {"type": "number", "minimum": 0},
          "endSeconds": {"type": "number", "exclusiveMinimum": 0},
          "beat": {"type": "string"},
          "pictureAction": {"type": "string"},
          "camera": {"type": "string"},
          "focusAndLayers": {"type": "string"},
          "causalOverlap": {"type": "string"},
          "audioCue": {"type": ["string", "null"]},
          "implementation": {"type": "string"}
        }
      }
    },
    "parameterization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "editableInStudio", "fields", "testValues", "artifactNote"],
      "properties": {
        "mode": {"enum": ["parameterized", "fixed"]},
        "editableInStudio": {"type": "boolean"},
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "defaultValue", "purpose", "validation", "boundElements"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"enum": ["string", "number", "color", "boolean", "select"]},
              "defaultValue": {},
              "purpose": {"type": "string", "minLength": 1},
              "validation": {"type": "string", "minLength": 1},
              "boundElements": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          }
        },
        "testValues": {"type": "object"},
        "artifactNote": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "parameterized"}}},
          "then": {
            "properties": {
              "editableInStudio": {"const": true},
              "fields": {"minItems": 2}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "fixed"}}},
          "then": {"properties": {"editableInStudio": {"const": false}}}
        }
      ]
    },
    "remotionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compositionId", "components", "packages", "editableProps", "documentationToLoad", "checkFrames"],
      "properties": {
        "compositionId": {"type": "string", "minLength": 1},
        "components": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "packages": {"type": "array", "items": {"type": "string"}},
        "editableProps": {"type": "array", "items": {"type": "string"}},
        "documentationToLoad": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "checkFrames": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 3}
      }
    },
    "renderPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previewFirst", "previewScale", "previewMaxLongEdge", "previewCodec", "finalRenderRequiresApproval", "finalApprovalStatus", "finalApprovalEvidence", "rendererPolicy", "performanceNotes"],
      "properties": {
        "previewFirst": {"const": true},
        "previewScale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "previewMaxLongEdge": {"type": "integer", "minimum": 320},
        "previewCodec": {"type": "string", "minLength": 1},
        "finalRenderRequiresApproval": {"const": true},
        "finalApprovalStatus": {"enum": ["pending", "approved", "waived"]},
        "finalApprovalEvidence": {"type": ["string", "null"]},
        "rendererPolicy": {"enum": ["default-first", "software-fallback", "software-only"]},
        "performanceNotes": {"type": "string", "minLength": 1}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptanceCriteria", "evidenceRequired"],
      "properties": {
        "acceptanceCriteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "evidenceRequired": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"request": {"properties": {"inputMode": {"enum": ["image", "hybrid"]}}}}},
      "then": {
        "required": ["visualAnalysis"],
        "properties": {
          "visualAnalysis": {"type": "object"},
          "referenceFidelity": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"request": {"properties": {"inputMode": {"const": "text"}}}}},
      "then": {"properties": {"referenceFidelity": {"type": "null"}}}
    }
  ]
}
