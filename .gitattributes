# Normalize text files while keeping repo docs stable across Windows/macOS/Linux.
* text=auto

# AI context documents and source/reference snippets should stay LF.
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ps1 text eol=lf
.gitignore text eol=lf

# Binary assets/documents should never be line-ending normalized.
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
